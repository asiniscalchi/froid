TELEGRAM_BOT_TOKEN=
DATA_DIR=data
DATABASE_FILE=froid.sqlite3
RUST_LOG=info

# Embedding reconciliation worker (disabled by default)
FROID_EMBEDDING_WORKER_ENABLED=false
FROID_EMBEDDING_WORKER_BATCH_SIZE=20
FROID_EMBEDDING_WORKER_INTERVAL_SECONDS=300

# Extraction reconciliation worker (disabled by default)
# Retries entries with no extraction record and entries with status=failed
FROID_EXTRACTION_WORKER_ENABLED=false
FROID_EXTRACTION_WORKER_BATCH_SIZE=20
FROID_EXTRACTION_WORKER_INTERVAL_SECONDS=300

# MCP HTTP server (disabled by default). When enabled, runs alongside the Telegram bot.
FROID_MCP_ENABLED=false
FROID_MCP_BIND=127.0.0.1:8080

# The MCP listener always requires bearer tokens. Users mint their own by
# sending /token to the Telegram bot (rotate with /token, disable with
# /token revoke); each request is served from the token owner's isolated
# database.

# Required when FROID_EMBEDDING_WORKER_ENABLED=true or FROID_EXTRACTION_WORKER_ENABLED=true
OPENAI_API_KEY=

# Optional: point all LLM and embedding requests at any OpenAI-compatible
# endpoint (e.g. Ollama: http://localhost:11434/v1). Defaults to openai.com.
#OPENAI_BASE_URL=
